// ---------------------------------------------------------------------------
// Version catalog
// ---------------------------------------------------------------------------
object V {
  val scala               = "3.9.0"
  val scalaJS             = "1.22.0"
  val zio                 = "2.1.27"
  val zioJson             = "1.1.1"
  val scalaJavaTime       = "2.8.0"
  val scalaJsSecureRandom = "1.0.0"
  val taiheiTsuji         = "5.0.0" // dev.taihei::taihei-tsuji (Language)
}

// ---------------------------------------------------------------------------
// Version from git: an exact v-tag on a clean tree is the release, anything else
// a SNAPSHOT of the last tag. Untracked files do not count. A Task.Input, so a
// new commit, tag or edit is seen without restarting the Mill daemon. The
// release itself is the Makefile's (release-prepare / release-finalize).
// ---------------------------------------------------------------------------
object release extends Module {
  private def gitAt(root: os.Path, args: String*) = os.proc("git", args).call(cwd = root, check = false)

  // Not being at an exact tag is the normal case, so this probe's "no tag exactly matches" is kept
  // out of the log. Every other git error stays visible: a describe that fails for another reason
  // (a shallow clone, git refusing the repository) must not leave MiMa without a baseline unseen.
  private def isExactTag(root: os.Path) = os
    .proc("git", "describe", "--tags", "--exact-match", "--match", "v[0-9]*")
    .call(cwd = root, check = false, stderr = os.Pipe)
    .exitCode == 0

  def gitVersion = Task.Input {
    val root     = os.Path(sys.env("MILL_WORKSPACE_ROOT"))
    def git(args: String*) = gitAt(root, args*)
    val tag      = git("describe", "--tags", "--abbrev=0", "--match", "v[0-9]*")
    val version  = if (tag.exitCode == 0) tag.out.trim().stripPrefix("v") else "0.0.0"
    val exactTag = isExactTag(root)
    val clean    = git("status", "--porcelain").out.text().linesIterator.forall(_.startsWith("??"))
    if (exactTag && clean) version else s"$version-SNAPSHOT"
  }

  // The first release as dev.taihei::taihei-mihon. Older tags are genius-lorem, edo-lorem and
  // taihei-lorem, other artifacts, so there is nothing of this one on Central to compare them with.
  val firstRelease = "5.0.0"

  // The first release of the major line main is on. MiMa compares only within a major line: a
  // major may break, so a release of the previous major is no baseline for it. Raise this when
  // work on the next major starts on main; release-prepare TYPE=major still sets none.
  val majorLine = "5.0.0"

  // Where a version of this library is on Maven Central: the JVM module's POM.
  private def centralPom(v: String) =
    s"https://repo1.maven.org/maven2/dev/taihei/taihei-mihon_3/$v/taihei-mihon_3-$v.pom"

  // Whether Maven Central has a version: 200 yes, 404 no, anything else fails the build, since
  // a baseline we cannot determine must not turn into no baseline.
  private def onCentral(v: String): Boolean = {
    val code = os
      .proc("curl", "-s", "--max-time", "30", "-o", "/dev/null", "-w", "%{http_code}", centralPom(v))
      .call(check = false)
      .out
      .trim()
    code match {
      case "200" => true
      case "404" => false
      case other => sys.error(s"cannot tell whether $v is on Maven Central (HTTP $other): no MiMa baseline")
    }
  }

  // The release MiMa compares with: the newest v-tag reachable from HEAD whose version is on Maven
  // Central, none before firstRelease or majorLine. A release is tagged and pushed once it is on
  // GitHub Packages, and reaches Central with the next release train (ADR 0003), so the newest tag
  // may name a version MiMa cannot resolve yet: that tag is named in the log, and the baseline is
  // the newest tag before it that Central has. At most one version waits at a time, which
  // release-prepare enforces. On a release itself (an exact v-tag on a clean tree, as in CI on the
  // tagged commit) that tag is HEAD's own, which would compare the release with itself; so there
  // the search starts at the commit before it. MIMA_BASELINE overrides it: `none` for a major,
  // which may break (release-prepare TYPE=major sets it), or a version.
  def mimaBaseline = Task.Input {
    val root = os.Path(sys.env("MILL_WORKSPACE_ROOT"))
    def git(args: String*) = gitAt(root, args*)
    def numbers(v: String) = v.split('.').toSeq.map(_.toIntOption.getOrElse(0))
    def atLeast(v: String, floor: String) = Ordering.Implicits.seqOrdering[Seq, Int].gteq(numbers(v), numbers(floor))
    Task.env.get("MIMA_BASELINE").map(_.trim).filter(_.nonEmpty) match {
      case Some("none") => None
      case Some(v)      => Some(v)
      case None         =>
        val exactTag = isExactTag(root)
        val clean    = git("status", "--porcelain").out.text().linesIterator.forall(_.startsWith("??"))
        // HEAD^ of a root commit does not exist: then there is no tag before it and no baseline.
        val from   = if (exactTag && clean) "HEAD^" else "HEAD"
        val listed = git("tag", "--merged", from, "--list", "v[0-9]*", "--sort=-v:refname")
        if (listed.exitCode != 0 && from == "HEAD")
          sys.error(s"git tag --merged HEAD failed: ${listed.err.text().trim()}")
        val candidates = listed.out
          .lines()
          .map(_.trim.stripPrefix("v"))
          .filter(_.matches("[0-9]+\\.[0-9]+\\.[0-9]+"))
          .filter(v => atLeast(v, firstRelease) && atLeast(v, majorLine))
        val (waiting, rest) = candidates.span(v => !onCentral(v))
        waiting.foreach { v =>
          Task.log.warn(s"v$v is not on Maven Central yet: it waits for the release train, so MiMa compares with the newest tag on Central")
        }
        rest.headOption
    }
  }
}

// ---------------------------------------------------------------------------
// Binary compatibility: MiMa compares the artifact with the baseline release on Central and
// fails on a break (`make mima`, part of validate). No baseline, nothing to compare.
// ---------------------------------------------------------------------------
trait TaiheiMima extends Mima with PublishModule {
  def mimaPreviousVersions = Task(release.mimaBaseline().toSeq)
  // The plugin's default fails without a version; no baseline here means nothing to compare.
  def mimaPreviousArtifacts = Task {
    mimaPreviousVersions().map(v => mvn"${pomSettings().organization}:${artifactId()}:$v")
  }
}

// ---------------------------------------------------------------------------
// Shared publishing settings for JVM and JS modules: what Maven Central
// validates (name, description, url, licence, developer, scm, sources, docs).
// ---------------------------------------------------------------------------
trait TaiheiPublishSettings extends PublishModule {
  def publishVersion = release.gitVersion()

  // What a published jar holds comes only from folders in git: no default folder under the
  // module's directory, where a stray file would go into a jar unnoticed. A module that has
  // resources names them.
  def resources        = Task.Sources()
  def compileResources = Task.Sources()
  def docResources     = Task.Sources()

  def pomSettings = PomSettings(
    description = "Composable, cross-platform fake-data and Lorem Ipsum generator for Scala 3; JVM & JS",
    organization = "dev.taihei",
    url = "https://github.com/taiheiframework/mihon",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("taiheiframework", "mihon"),
    developers = Seq(
      Developer("innovenso", "Innovenso BV", "https://taihei.dev", Some("Innovenso BV"), Some("https://innovenso.com")),
    ),
  )
}

// ---------------------------------------------------------------------------
// Base trait for JVM modules
// ---------------------------------------------------------------------------
trait TaiheiModule extends ScalaModule with ScalafmtModule with ScalafixModule with TaiheiPublishSettings with TaiheiMima {
  def scalaVersion = V.scala

  def scalacOptions = Seq(
    "-Wunused:all",
    "-unchecked",
    "-deprecation",
    "-feature",
    "-Xmax-inlines:128",
  )

  trait TaiheiTests extends ScalaTests with ScalafmtModule with ScalafixModule {
    def testFramework = "zio.test.sbt.ZTestFramework"

    def forkArgs = Seq(
      "-Xmx4G",
      "-Xms2G",
      "-Xss16M",
      "-XX:+UseG1GC",
      "-XX:MaxGCPauseMillis=200",
    )

    def mvnDeps = Seq(
      mvn"dev.zio::zio-test:${V.zio}",
      mvn"dev.zio::zio-test-sbt:${V.zio}",
    )
  }
}

// ---------------------------------------------------------------------------
// Base trait for Scala.js modules
// ---------------------------------------------------------------------------
trait TaiheiJSModule extends ScalaJSModule with ScalafmtModule with ScalafixModule with TaiheiPublishSettings with TaiheiMima {
  def scalaVersion   = V.scala
  def scalaJSVersion = V.scalaJS

  def scalacOptions = Seq(
    "-Wunused:all",
    "-unchecked",
    "-deprecation",
    "-feature",
    "-Xmax-inlines:128",
  )

  // Scala.js polyfills used by the shared sources: java.time (scala-java-time +
  // tzdb) and java.security.SecureRandom (scalajs-java-securerandom).
  def jsDeps = Seq(
    mvn"io.github.cquiroz::scala-java-time::${V.scalaJavaTime}",
    mvn"io.github.cquiroz::scala-java-time-tzdb::${V.scalaJavaTime}",
    mvn"org.scala-js::scalajs-java-securerandom::${V.scalaJsSecureRandom}".withDottyCompat(V.scala),
  )

  trait TaiheiJSTests extends ScalaJSTests with ScalafmtModule with ScalafixModule {
    def testFramework = "zio.test.sbt.ZTestFramework"

    def mvnDeps = Seq(
      mvn"dev.zio::zio-test::${V.zio}",
      mvn"dev.zio::zio-test-sbt::${V.zio}",
    )
  }
}

// ---------------------------------------------------------------------------
// The name lists for Scala.js: every file in the folder must be a non-empty JSON array of
// strings, or the build fails. Each list is written back as normalised JSON inside a Scala string
// literal escaped by ujson, ASCII only, so nothing in a file can end the literal or reach the
// generated code. Files are sorted by name, so the output is the same on every machine.
// ---------------------------------------------------------------------------
object EmbeddedLists {
  def write(folder: os.Path, classpathPrefix: String, dest: os.Path): PathRef = {
    // A symlink would bring in whatever it points at, outside the repository included.
    if (os.isLink(folder) || !os.isDir(folder, followLinks = false)) sys.error(s"$folder: not a folder")
    val files = os.list(folder).sortBy(_.last)
    val lists = files.map { file =>
      if (os.isLink(file) || !os.isFile(file, followLinks = false) || file.ext != "json")
        sys.error(s"$file: only JSON name lists belong in $folder")
      val words = ujson.read(os.read(file)) match {
        case ujson.Arr(items) if items.nonEmpty =>
          items.map {
            case ujson.Str(word) if word.nonEmpty => word
            case other                            => sys.error(s"$file: not a non-empty string: $other")
          }.toSeq
        case _ => sys.error(s"$file: not a non-empty JSON array of strings")
      }
      val json = ujson.write(ujson.Arr(words.map(ujson.Str(_))*))
      s"$classpathPrefix/${file.last}" -> ujson.write(ujson.Str(json), escapeUnicode = true)
    }
    if (lists.isEmpty) sys.error(s"$folder holds no name lists")
    val entries = lists.map { case (path, literal) =>
      s"    ${ujson.write(ujson.Str(path), escapeUnicode = true)} -> $literal,"
    }
    val source =
      s"""|// Generated by build.mill from shared/resources: do not edit.
          |package dev.taihei.mihon.sources
          |
          |// The JSON name lists by classpath path, for the Scala.js ResourceLoader.
          |private[mihon] object EmbeddedLists:
          |  val byPath: Map[String, String] = Map(
          |${entries.mkString("\n")}
          |  )
          |""".stripMargin
    os.write.over(dest / "EmbeddedLists.scala", source, createFolders = true)
    PathRef(dest)
  }
}

// ---------------------------------------------------------------------------
// Workspace root for resolving cross-platform source paths
// ---------------------------------------------------------------------------
val wsRoot = os.Path(sys.env("MILL_WORKSPACE_ROOT"))

// ---------------------------------------------------------------------------
// Module: mihon (cross-platform JVM + JS)
//   shared sources compile on both platforms; jvm/ and js/ hold the
//   platform-specific resource loaders (the JVM reads the name lists from the
//   classpath; JS embeds them). Depends on taihei-tsuji for Language.
// ---------------------------------------------------------------------------
object mihon extends Module {
  object jvm extends TaiheiModule {
    def artifactName = "taihei-mihon"

    def sources = Task.Sources(
      wsRoot / "shared" / "src",
      wsRoot / "jvm" / "src",
    )
    // The name lists, read from the classpath.
    def resources = Task.Sources(
      wsRoot / "shared" / "resources",
    )

    def mvnDeps = Seq(
      mvn"dev.zio::zio-json:${V.zioJson}",
      mvn"dev.taihei::taihei-tsuji:${V.taiheiTsuji}",
    )

    object test extends TaiheiTests {
      def sources = Task.Sources(
        wsRoot / "shared" / "test" / "src",
      )
    }
  }

  object js extends TaiheiJSModule {
    def artifactName = "taihei-mihon"

    def sources = Task.Sources(
      wsRoot / "shared" / "src",
      wsRoot / "js" / "src",
    )

    def mvnDeps = Seq(
      mvn"dev.zio::zio-json::${V.zioJson}",
      mvn"dev.taihei::taihei-tsuji::${V.taiheiTsuji}",
    ) ++ jsDeps

    // Scala.js has no classpath to read the name lists from, so they are compiled in. They are
    // generated from shared/resources, the one copy the JVM reads too, so the platforms cannot
    // drift apart (until 5.0.0 a hand-copied list on Scala.js did).
    def nameLists = Task.Source(wsRoot / "shared" / "resources" / "dev" / "taihei" / "mihon" / "sources")

    def generatedSources = Task {
      Seq(EmbeddedLists.write(nameLists().path, "/dev/taihei/mihon/sources", Task.dest))
    }

    object test extends TaiheiJSTests {
      def sources = Task.Sources(
        wsRoot / "shared" / "test" / "src",
      )
    }
  }
}
