object V {
  val scala               = "3.9.0"
  val scalaJS             = "1.22.0"
  val zio                 = "2.1.27"
  val zioJson             = "1.1.1"
  val scalaJavaTime       = "2.8.0"
  val scalaJsSecureRandom = "1.0.0"
  val taiheiTsuji         = "5.0.0" // dev.taihei::taihei-tsuji (Language)
}

// ---------------------------------------------------------------------------
// Version from git: an exact v-tag on a clean tree is the release, anything else
// a SNAPSHOT of the last tag. Untracked files do not count. A Task.Input, so a
// new commit, tag or edit is seen without restarting the Mill daemon. The
// release itself is the Makefile's (release-prepare / release-finalize).
// ---------------------------------------------------------------------------
object release extends Module {
  private def gitAt(root: os.Path, args: String*) = os.proc("git", args).call(cwd = root, check = false)

  // Not being at an exact tag is the normal case, so this probe's "no tag exactly matches" is kept
  // out of the log. Every other git error stays visible: a describe that fails for another reason
  // (a shallow clone, git refusing the repository) must not leave MiMa without a baseline unseen.
  private def isExactTag(root: os.Path) = os
    .proc("git", "describe", "--tags", "--exact-match", "--match", "v[0-9]*")
    .call(cwd = root, check = false, stderr = os.Pipe)
    .exitCode == 0

  def gitVersion = Task.Input {
    val root     = os.Path(sys.env("MILL_WORKSPACE_ROOT"))
    def git(args: String*) = gitAt(root, args*)
    val tag      = git("describe", "--tags", "--abbrev=0", "--match", "v[0-9]*")
    val version  = if (tag.exitCode == 0) tag.out.trim().stripPrefix("v") else "0.0.0"
    val exactTag = isExactTag(root)
    val clean    = git("status", "--porcelain").out.text().linesIterator.forall(_.startsWith("??"))
    if (exactTag && clean) version else s"$version-SNAPSHOT"
  }

  // The first release as dev.taihei::taihei-mihon. Older tags are genius-lorem, edo-lorem and
  // taihei-lorem, other artifacts, so there is nothing of this one on Central to compare them with.
  val firstRelease = "5.0.0"

  // The first release of the major line main is on. MiMa compares only within a major line: a
  // major may break, so a release of the previous major is no baseline for it. Raise this when
  // work on the next major starts on main; release-prepare TYPE=major still sets none.
  val majorLine = "5.0.0"

  // Where a version of this library is on Maven Central: the JVM module's POM.
  private def centralPom(v: String) =
    s"https://repo1.maven.org/maven2/dev/taihei/taihei-mihon_3/$v/taihei-mihon_3-$v.pom"

  // Whether Maven Central has a version: 200 yes, 404 no, anything else fails the build, since
  // a baseline we cannot determine must not turn into no baseline.
  private def onCentral(v: String): Boolean = {
    val code = os
      .proc("curl", "-q", "-s", "--proto", "=https", "--max-time", "30", "-o", "/dev/null", "-w", "%{http_code}", centralPom(v))
      .call(check = false)
      .out
      .trim()
    code match {
      case "200" => true
      case "404" => false
      case other => sys.error(s"cannot tell whether $v is on Maven Central (HTTP $other): no MiMa baseline")
    }
  }

  // The release MiMa compares with: the newest v-tag reachable from HEAD whose version is on Maven
  // Central, none before firstRelease or majorLine. A release is tagged and pushed once it is on
  // GitHub Packages, and reaches Central with the next release train (ADR 0003), so the newest tag
  // may name a version MiMa cannot resolve yet: that tag is named in the log, and the baseline is
  // the newest tag before it that Central has. At most one version waits at a time, which
  // release-prepare enforces. On a release itself (an exact v-tag on a clean tree, as in CI on the
  // tagged commit) that tag is HEAD's own, which would compare the release with itself; so there
  // the search starts at the commit before it. MIMA_BASELINE overrides it: `none` for a major,
  // which may break (release-prepare TYPE=major sets it), or a version.
  def mimaBaseline = Task.Input {
    val root = os.Path(sys.env("MILL_WORKSPACE_ROOT"))
    def git(args: String*) = gitAt(root, args*)
    def numbers(v: String) = v.split('.').toSeq.map(_.toIntOption.getOrElse(0))
    def atLeast(v: String, floor: String) = Ordering.Implicits.seqOrdering[Seq, Int].gteq(numbers(v), numbers(floor))
    Task.env.get("MIMA_BASELINE").map(_.trim).filter(_.nonEmpty) match {
      case Some("none") => None
      case Some(v)      => Some(v)
      case None         =>
        val exactTag = isExactTag(root)
        val clean    = git("status", "--porcelain").out.text().linesIterator.forall(_.startsWith("??"))
        // HEAD^ of a root commit does not exist: then there is no tag before it and no baseline.
        val from   = if (exactTag && clean) "HEAD^" else "HEAD"
        // Only a root commit has no HEAD^; any other git failure (a shallow clone, say) must not
        // pass as "no baseline".
        if (git("rev-parse", "--is-shallow-repository").out.trim() != "false")
          sys.error("a shallow clone (or git failed): fetch the full history and the tags, or set MIMA_BASELINE")
        val hasFrom = gitAt(root, "rev-parse", "-q", "--verify", s"$from^{commit}").exitCode == 0
        if (!hasFrom && from == "HEAD") sys.error("git cannot read HEAD: no MiMa baseline")
        val listed = git("tag", "--merged", from, "--list", "v[0-9]*", "--sort=-v:refname")
        if (hasFrom && listed.exitCode != 0)
          sys.error(s"git tag --merged $from failed: ${listed.err.text().trim()}")
        val candidates = listed.out
          .lines()
          .map(_.trim.stripPrefix("v"))
          .filter(_.matches("[0-9]+\\.[0-9]+\\.[0-9]+"))
          .filter(v => atLeast(v, firstRelease) && atLeast(v, majorLine))
        val (waiting, rest) = candidates.span(v => !onCentral(v))
        waiting.foreach { v =>
          Task.log.warn(s"v$v is not on Maven Central yet: it waits for the release train, so MiMa compares with the newest tag on Central")
        }
        rest.headOption
    }
  }
}

// ---------------------------------------------------------------------------
// Binary compatibility: MiMa compares the artifact with the baseline release on Central and
// fails on a break (`make mima`, part of validate). No baseline, nothing to compare.
// ---------------------------------------------------------------------------
trait TaiheiMima extends Mima with PublishModule {
  def mimaPreviousVersions = Task(release.mimaBaseline().toSeq)
  // The plugin's default fails without a version; no baseline here means nothing to compare.
  def mimaPreviousArtifacts = Task {
    mimaPreviousVersions().map(v => mvn"${pomSettings().organization}:${artifactId()}:$v")
  }
}

// ---------------------------------------------------------------------------
// Shared publishing settings for JVM and JS modules: what Maven Central
// validates (name, description, url, licence, developer, scm, sources, docs).
// ---------------------------------------------------------------------------
trait TaiheiPublishSettings extends PublishModule {
  def publishVersion = release.gitVersion()

  // What a published jar holds comes only from folders in git: no default folder under the
  // module's directory, where a stray file would go into a jar unnoticed. A module that has
  // resources names them.
  def resources        = Task.Sources()
  def compileResources = Task.Sources()
  def docResources     = Task.Sources()

  def pomSettings = PomSettings(
    description = "Composable, cross-platform fake-data and Lorem Ipsum generator for Scala 3; JVM & JS",
    organization = "dev.taihei",
    url = "https://github.com/taiheiframework/mihon",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("taiheiframework", "mihon"),
    developers = Seq(
      Developer("innovenso", "Innovenso BV", "https://taihei.dev", Some("Innovenso BV"), Some("https://innovenso.com")),
    ),
  )
}

// ---------------------------------------------------------------------------
// Base trait for JVM modules
// ---------------------------------------------------------------------------
trait TaiheiModule extends ScalaModule with ScalafmtModule with ScalafixModule with TaiheiPublishSettings with TaiheiMima {
  def scalaVersion = V.scala

  def scalacOptions = Seq(
    "-Wunused:all",
    "-unchecked",
    "-deprecation",
    "-feature",
    "-Xmax-inlines:128",
    // Java 17 is the JVM floor (Scala 3.9's too). This compiles against the Java 17 API, not the
    // API of the JDK that runs the build, so a call added in a later Java fails here, on any JDK,
    // instead of at run time on a user's Java 17.
    "-java-output-version:17",
  )

  trait TaiheiTests extends ScalaTests with ScalafmtModule with ScalafixModule {
    def testFramework = "zio.test.sbt.ZTestFramework"

    // The JDK the tests run on: the module's (Mill's own) unless TAIHEI_TEST_JAVA_HOME names
    // another. CI runs them once more on Java 17, the oldest Java the library supports. Only the
    // tests: what is compiled and published does not depend on it.
    def testJavaHome = Task.Input(Task.env.get("TAIHEI_TEST_JAVA_HOME").map(_.trim).filter(_.nonEmpty))
    def javaHome     = Task {
      testJavaHome().map(home => PathRef(os.Path(home), quick = true)).orElse(TaiheiModule.this.javaHome())
    }

    def forkArgs = Seq(
      "-Xmx4G",
      "-Xms2G",
      "-Xss16M",
      "-XX:+UseG1GC",
      "-XX:MaxGCPauseMillis=200",
    )

    def mvnDeps = Seq(
      mvn"dev.zio::zio-test:${V.zio}",
      mvn"dev.zio::zio-test-sbt:${V.zio}",
    )
  }
}

// ---------------------------------------------------------------------------
// Base trait for Scala.js modules
// ---------------------------------------------------------------------------
trait TaiheiJSModule extends ScalaJSModule with ScalafmtModule with ScalafixModule with TaiheiPublishSettings with TaiheiMima {
  def scalaVersion   = V.scala
  def scalaJSVersion = V.scalaJS

  def scalacOptions = Seq(
    "-Wunused:all",
    "-unchecked",
    "-deprecation",
    "-feature",
    "-Xmax-inlines:128",
  )

  // Scala.js polyfills used by the shared sources: java.time (scala-java-time +
  // tzdb) and java.security.SecureRandom (scalajs-java-securerandom).
  def jsDeps = Seq(
    mvn"io.github.cquiroz::scala-java-time::${V.scalaJavaTime}",
    mvn"io.github.cquiroz::scala-java-time-tzdb::${V.scalaJavaTime}",
    mvn"org.scala-js::scalajs-java-securerandom::${V.scalaJsSecureRandom}".withDottyCompat(V.scala),
  )

  trait TaiheiJSTests extends ScalaJSTests with ScalafmtModule with ScalafixModule {
    def testFramework = "zio.test.sbt.ZTestFramework"

    def mvnDeps = Seq(
      mvn"dev.zio::zio-test::${V.zio}",
      mvn"dev.zio::zio-test-sbt::${V.zio}",
    )
  }
}

// ---------------------------------------------------------------------------
// The language data (shared/resources/dev/taihei/mihon/data/). The build checks every file
// against the schema the library decodes (Files.scala), so a malformed file fails the build on
// both platforms and the library's own decoding cannot fail at run time. For Scala.js, which
// has no classpath, it then writes each file into a generated Scala source.
// ---------------------------------------------------------------------------
object EmbeddedData {
  // The size budget (TAIHEI-40): data per language, all data, the JVM jar, and the full-linked
  // Scala.js of a fixture that uses every language.
  val maxLanguageBytes = 80 * 1024
  val maxDataBytes     = 2560 * 1024
  val maxJarBytes      = 1200 * 1024
  val maxJsBytes       = 6 * 1024 * 1024

  private val maxWords = 2000

  private def fail(file: os.Path, msg: String): Nothing = sys.error(s"$file: $msg")

  // A file that is a regular file and not a link: a link would bring in whatever it points at,
  // outside the repository included.
  private def regular(file: os.Path): Unit =
    if (os.isLink(file) || !os.isFile(file, followLinks = false)) fail(file, "not a regular file")

  private def folder(dir: os.Path): Unit =
    if (os.isLink(dir) || !os.isDir(dir, followLinks = false)) fail(dir, "not a folder")

  private def obj(file: os.Path, v: ujson.Value, where: String, required: Set[String], optional: Set[String] = Set()) = v match {
    case ujson.Obj(fields) =>
      val keys = fields.keySet.toSet
      val missing = required -- keys
      val unknown = keys -- required -- optional
      if (missing.nonEmpty) fail(file, s"$where: missing ${missing.toSeq.sorted.mkString(", ")}")
      if (unknown.nonEmpty) fail(file, s"$where: unknown ${unknown.toSeq.sorted.mkString(", ")}")
      fields
    case _ => fail(file, s"$where: not an object")
  }

  private def str(file: os.Path, v: ujson.Value, where: String, nonEmpty: Boolean = false): String = v match {
    case ujson.Str(s) if !nonEmpty || s.nonEmpty =>
      // No control characters, no unpaired surrogates and no byte order marks in the data.
      if (s.exists(c => c < ' ' || c == '\u007f' || c == '﻿')) fail(file, s"$where: a control character")
      s.indices.foreach { i =>
        val c = s(i)
        if (Character.isHighSurrogate(c) && (i + 1 >= s.length || !Character.isLowSurrogate(s(i + 1))))
          fail(file, s"$where: an unpaired surrogate")
        if (Character.isLowSurrogate(c) && (i == 0 || !Character.isHighSurrogate(s(i - 1))))
          fail(file, s"$where: an unpaired surrogate")
      }
      s
    case _ => fail(file, s"$where: not a${if (nonEmpty) " non-empty" else ""} string")
  }

  private def bool(file: os.Path, v: ujson.Value, where: String): Boolean = v match {
    case ujson.Bool(b) => b
    case _             => fail(file, s"$where: not a boolean")
  }

  private def int(file: os.Path, v: ujson.Value, where: String, min: Int, max: Int): Int = v match {
    case ujson.Num(n) if n == math.floor(n) && n >= min && n <= max => n.toInt
    case _                                                           => fail(file, s"$where: not an integer in [$min, $max]")
  }

  private def arr(file: os.Path, v: ujson.Value, where: String, nonEmpty: Boolean = true, max: Int = 100000) = v match {
    case ujson.Arr(items) if (!nonEmpty || items.nonEmpty) && items.size <= max => items.toSeq
    case _ => fail(file, s"$where: not a${if (nonEmpty) " non-empty" else "n"} array of at most $max")
  }

  private def pair(file: os.Path, v: ujson.Value, where: String): (ujson.Value, ujson.Value) = arr(file, v, where) match {
    case Seq(a, b) => (a, b)
    case _         => fail(file, s"$where: not a pair")
  }

  private def ascii(s: String) = s.forall(c => c >= ' ' && c <= '~')

  // Weighted [value, weight] pairs whose weights add up to at most Int.MaxValue.
  private def weighted(file: os.Path, v: ujson.Value, where: String, max: Int = 100000, nonEmpty: Boolean = true): Seq[String] = {
    var total = 0L
    val values = arr(file, v, where, nonEmpty = nonEmpty, max = max).zipWithIndex.map { case (item, i) =>
      val (value, weight) = pair(file, item, s"$where[$i]")
      total += int(file, weight, s"$where[$i] weight", 1, Int.MaxValue)
      str(file, value, s"$where[$i]", nonEmpty = true)
    }
    if (total > Int.MaxValue) fail(file, s"$where: the weights add up beyond ${Int.MaxValue}")
    values
  }

  private def placeholders(s: String): Seq[String] = "\\{([^{}]*)\\}".r.findAllMatchIn(s).map(_.group(1)).toSeq

  private def template(file: os.Path, v: ujson.Value, where: String, allowed: Set[String]): Unit = {
    val s = str(file, v, where, nonEmpty = true)
    if (s.count(_ == '{') != s.count(_ == '}')) fail(file, s"$where: unbalanced braces")
    val unknown = placeholders(s).filterNot(allowed)
    if (unknown.nonEmpty) fail(file, s"$where: unknown placeholders ${unknown.mkString(", ")}")
  }

  private val addressFields = Set("street", "city", "region", "postalCode", "country")
  private val streetFields  = Set("family", "familyFemale", "given", "word", "Word", "number", "small")

  final case class Entry(tag: String, script: String, country: String)

  private def checkLanguages(file: os.Path): Seq[Entry] = {
    val root = obj(file, ujson.read(os.read(file)), "languages.json", Set("languages", "aliases"))
    val entries = arr(file, root("languages"), "languages").zipWithIndex.map { case (v, i) =>
      val o = obj(file, v, s"languages[$i]", Set("tag", "script", "country"))
      val tag = str(file, o("tag"), s"languages[$i].tag")
      if (!tag.matches("[a-z]{2,3}(-[A-Z][a-z]{3})?")) fail(file, s"languages[$i].tag: not a language with an optional script: $tag")
      val script = str(file, o("script"), s"languages[$i].script")
      if (!script.matches("[A-Z][a-z]{3}")) fail(file, s"languages[$i].script: not a script subtag: $script")
      val country = str(file, o("country"), s"languages[$i].country")
      if (!country.matches("[A-Z]{2}")) fail(file, s"languages[$i].country: not an ISO 3166-1 alpha-2 code: $country")
      Entry(tag, script, country)
    }
    val tags = entries.map(_.tag)
    if (tags.distinct.size != tags.size) fail(file, "a language listed twice")
    arr(file, root("aliases"), "aliases", nonEmpty = false).zipWithIndex.foreach { case (v, i) =>
      val (a, t) = pair(file, v, s"aliases[$i]")
      val alias  = str(file, a, s"aliases[$i]", nonEmpty = true)
      if (!alias.matches("[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?")) fail(file, s"aliases[$i]: not a tag: $alias")
      if (!tags.contains(str(file, t, s"aliases[$i] target"))) fail(file, s"aliases[$i]: an alias of a language without data")
    }
    entries
  }

  private def checkText(file: os.Path, cased: Boolean => Unit): Unit = {
    val strings = Seq("wordSeparator", "sentenceSeparator", "fullStop", "questionOpen", "questionMark",
      "exclamationOpen", "exclamationMark", "comma", "quoteOpen", "quoteClose")
    val o = obj(file, ujson.read(os.read(file)), "text", strings.toSet ++ Set("cased", "titleCase", "capitals", "wordsPerSentence", "words"))
    strings.foreach(k => str(file, o(k), k))
    cased(bool(file, o("cased"), "cased"))
    bool(file, o("titleCase"), "titleCase")
    arr(file, o("capitals"), "capitals", nonEmpty = false).zipWithIndex.foreach { case (v, i) =>
      val (k, c) = pair(file, v, s"capitals[$i]")
      val key = str(file, k, s"capitals[$i]", nonEmpty = true)
      if (key.codePointCount(0, key.length) > 2) fail(file, s"capitals[$i]: more than two letters")
      str(file, c, s"capitals[$i] capital", nonEmpty = true)
    }
    val (lo, hi) = pair(file, o("wordsPerSentence"), "wordsPerSentence")
    val min = int(file, lo, "wordsPerSentence min", 1, 50)
    int(file, hi, "wordsPerSentence max", min, 50)
    weighted(file, o("words"), "words", max = maxWords)
  }

  private def checkForm(file: os.Path, o: collection.Map[String, ujson.Value], where: String, latinScript: Boolean): Unit = {
    val name    = str(file, o("name"), s"$where.name", nonEmpty = true)
    val latin   = o.get("latin").map(str(file, _, s"$where.latin", nonEmpty = true))
    val asciiF  = o.get("ascii").map(str(file, _, s"$where.ascii", nonEmpty = true))
    o.get("reading").foreach(str(file, _, s"$where.reading", nonEmpty = true))
    if (!latinScript && latin.isEmpty) fail(file, s"$where: a name in another script than Latin needs its latin form")
    val effective = asciiF.orElse(latin).getOrElse(name)
    if (!ascii(effective)) fail(file, s"$where: no ASCII form (ascii) for $effective")
  }

  private def checkNames(file: os.Path, latinScript: Boolean): Unit = {
    val o = obj(file, ujson.read(os.read(file)), "names", Set("order", "separator", "female", "male", "family"))
    str(file, o("order"), "order") match {
      case "given-family" | "family-given" =>
      case other                           => fail(file, s"order: $other")
    }
    str(file, o("separator"), "separator")
    val formKeys = Set("latin", "ascii", "reading")
    Seq("female", "male").foreach { list =>
      var total = 0L
      arr(file, o(list), list).zipWithIndex.foreach { case (v, i) =>
        val e = obj(file, v, s"$list[$i]", Set("name", "weight"), formKeys)
        checkForm(file, e, s"$list[$i]", latinScript)
        total += int(file, e("weight"), s"$list[$i].weight", 1, Int.MaxValue)
      }
      if (total > Int.MaxValue) fail(file, s"$list: the weights add up beyond ${Int.MaxValue}")
    }
    var total = 0L
    arr(file, o("family"), "family").zipWithIndex.foreach { case (v, i) =>
      val e = obj(file, v, s"family[$i]", Set("name", "weight"), formKeys + "female")
      checkForm(file, e, s"family[$i]", latinScript)
      total += int(file, e("weight"), s"family[$i].weight", 1, Int.MaxValue)
      e.get("female").foreach(f => checkForm(file, obj(file, f, s"family[$i].female", Set("name"), formKeys), s"family[$i].female", latinScript))
    }
    if (total > Int.MaxValue) fail(file, s"family: the weights add up beyond ${Int.MaxValue}")
  }

  private def checkCountries(file: os.Path, own: String): Unit = {
    val codes = arr(file, ujson.read(os.read(file)), "countries").zipWithIndex.map { case (v, i) =>
      val (c, n) = pair(file, v, s"countries[$i]")
      val code   = str(file, c, s"countries[$i]")
      if (!code.matches("[A-Z]{2}")) fail(file, s"countries[$i]: not an ISO 3166-1 alpha-2 code: $code")
      str(file, n, s"countries[$i] name", nonEmpty = true)
      code
    }
    if (codes != codes.sorted.distinct) fail(file, "countries: not sorted by code, or a code listed twice")
    if (!codes.contains(own)) fail(file, s"countries: no name for the language's own country $own")
  }

  private def checkCountry(file: os.Path, code: String): Unit = {
    val o = obj(file, ujson.read(os.read(file)), "country",
      Set("code", "lines", "separator", "postalCode", "regions", "cities", "streets", "phone", "fictionalPhone"))
    if (str(file, o("code"), "code") != code) fail(file, s"code: not $code")
    arr(file, o("lines"), "lines").zipWithIndex.foreach { case (v, i) => template(file, v, s"lines[$i]", addressFields) }
    str(file, o("separator"), "separator")
    if (!ascii(str(file, o("postalCode"), "postalCode"))) fail(file, "postalCode: not ASCII")
    val regions = weighted(file, o("regions"), "regions", nonEmpty = false).toSet
    arr(file, o("cities"), "cities").zipWithIndex.foreach { case (v, i) =>
      val c = obj(file, v, s"cities[$i]", Set("name", "weight"), Set("region"))
      str(file, c("name"), s"cities[$i].name", nonEmpty = true)
      int(file, c("weight"), s"cities[$i].weight", 1, Int.MaxValue)
      c.get("region").foreach(r => if (!regions(str(file, r, s"cities[$i].region"))) fail(file, s"cities[$i].region: not one of regions"))
    }
    arr(file, o("streets"), "streets").zipWithIndex.foreach { case (v, i) => template(file, v, s"streets[$i]", streetFields) }
    val phone = str(file, o("phone"), "phone")
    if (!phone.matches("\\+[0-9]{1,3} [0-9#N ()-]+")) fail(file, s"phone: not +<calling code> and a national pattern: $phone")
    bool(file, o("fictionalPhone"), "fictionalPhone")
  }

  /**
   * Checks the whole data folder: languages.json and, for each language listed there, exactly
   * text.json, names.json, countries.json and country-<CC>.json; nothing else, no links, each file
   * in its schema. `resources` is the module's resource root, which must hold the data folder and
   * nothing else.
   */
  def check(resources: os.Path): Seq[os.Path] = {
    folder(resources)
    val data = resources / "dev" / "taihei" / "mihon" / "data"
    // Everything in the resource root is published in the JVM jar: only the data belongs there.
    os.walk(resources, followLinks = false).foreach { p =>
      if (!(p.startsWith(data) || data.startsWith(p))) fail(p, "only dev/taihei/mihon/data/ belongs in shared/resources")
    }
    folder(data)
    val languagesFile = data / "languages.json"
    regular(languagesFile)
    val entries  = checkLanguages(languagesFile)
    val expected = entries.flatMap { e =>
      val dir = data / os.SubPath(e.tag)
      Seq(dir / "text.json", dir / "names.json", dir / "countries.json", dir / s"country-${e.country}.json")
    }.toSet + languagesFile
    val present = os.walk(data, followLinks = false).filterNot(p => os.isDir(p, followLinks = false)).toSet
    (present -- expected).toSeq.sorted.foreach(p => fail(p, "not a data file of a listed language"))
    (expected -- present).toSeq.sorted.foreach(p => fail(p, "missing"))
    os.walk(data, followLinks = false).foreach { p =>
      if (os.isLink(p)) fail(p, "a link")
      if (os.isDir(p, followLinks = false) && p != data && !entries.exists(e => p == data / os.SubPath(e.tag)))
        fail(p, "not the folder of a listed language")
    }
    entries.foreach { e =>
      val dir = data / os.SubPath(e.tag)
      folder(dir)
      expected.filter(_.startsWith(dir)).foreach(regular)
      var cased = false
      checkText(dir / "text.json", c => cased = c)
      checkNames(dir / "names.json", e.script == "Latn")
      checkCountries(dir / "countries.json", e.country)
      checkCountry(dir / s"country-${e.country}.json", e.country)
      val bytes = os.walk(dir).filter(os.isFile(_)).map(os.size).sum
      if (bytes > maxLanguageBytes) fail(dir, s"$bytes bytes of data, more than the budget of $maxLanguageBytes")
    }
    val total = expected.toSeq.map(os.size).sum
    if (total > maxDataBytes) fail(data, s"$total bytes of data, more than the budget of $maxDataBytes")
    expected.toSeq.sorted
  }

  // A Scala string literal of `s`, ASCII only (ujson escapes the rest as \uXXXX), so nothing in a
  // data file can end the literal or reach the generated code.
  private def literal(s: String) = ujson.write(ujson.Str(s), escapeUnicode = true)

  // At most this many characters per literal: escaped as \uXXXX at worst, 60 000 bytes, below the
  // 65 535-byte limit the JVM class file sets on a constant, whatever a backend does with it.
  private val chunkChars = 10000

  private def chunks(s: String): Seq[String] = {
    val out = Seq.newBuilder[String]
    var i   = 0
    while (i < s.length) {
      var end = math.min(i + chunkChars, s.length)
      // Never between the two halves of a surrogate pair.
      if (end < s.length && Character.isHighSurrogate(s(end - 1))) end -= 1
      out += s.substring(i, end)
      i = end
    }
    out.result()
  }

  /** The Scala.js source with every data file, checked and unchanged, in path order. */
  def write(resources: os.Path, dest: os.Path): PathRef = {
    val files = check(resources)
    val defs  = files.zipWithIndex.map { case (file, i) =>
      // The file as it is, so the tests can compare it with the one on disk (DataManifest).
      val json  = os.read(file)
      val parts = chunks(json).map(c => s"      ${literal(c)},").mkString("\n")
      s"""  private def file$i: String =
         |    Seq(
         |$parts
         |    ).mkString""".stripMargin
    }
    val entries = files.zipWithIndex.map { case (file, i) =>
      s"    ${literal("/" + file.relativeTo(resources).toString)} -> (() => file$i),"
    }
    val source =
      s"""|// Generated by build.mill from shared/resources: do not edit.
          |package dev.taihei.mihon.sources
          |
          |// The data files by classpath path, for the Scala.js ResourceLoader.
          |private[mihon] object EmbeddedData:
          |  private val files: Map[String, () => String] = Map(
          |${entries.mkString("\n")}
          |  )
          |
          |  def get(path: String): Option[String] = files.get(path).map(_())
          |
          |${defs.mkString("\n\n")}
          |""".stripMargin
    os.write.over(dest / "EmbeddedData.scala", source, createFolders = true)
    PathRef(dest)
  }

  /**
   * The manifest the tests compare the loaded data with, on both platforms: each file's path,
   * length in UTF-16 units and String.hashCode (specified, so the same on the JVM and in
   * JavaScript), computed here from the files on disk.
   */
  def manifest(resources: os.Path, dest: os.Path): PathRef = {
    val files   = check(resources)
    val entries = files.map { file =>
      val text = os.read(file)
      s"    ${literal("/" + file.relativeTo(resources).toString)} -> (${text.length}, ${text.hashCode}),"
    }
    val source =
      s"""|// Generated by build.mill from shared/resources: do not edit.
          |package dev.taihei.mihon
          |
          |// Every data file on disk: path -> (length, String.hashCode).
          |object DataManifest:
          |  val files: Map[String, (Int, Int)] = Map(
          |${entries.mkString("\n")}
          |  )
          |""".stripMargin
    os.write.over(dest / "DataManifest.scala", source, createFolders = true)
    PathRef(dest)
  }

  // LICENSE, NOTICE and the Unicode licence of the CLDR and Unihan data in META-INF/ of every
  // published jar: the data ships in the jars, and its licences ask that their notices go with it.
  def metaInf(files: Seq[os.Path], dest: os.Path): PathRef = {
    files.foreach { f =>
      regular(f)
      os.copy.over(f, dest / "META-INF" / f.last, createFolders = true)
    }
    PathRef(dest)
  }
}

// ---------------------------------------------------------------------------
// Workspace root for resolving cross-platform source paths
// ---------------------------------------------------------------------------
val wsRoot = os.Path(sys.env("MILL_WORKSPACE_ROOT"))

// ---------------------------------------------------------------------------
// Module: mihon (cross-platform JVM + JS)
//   shared sources compile on both platforms; jvm/ and js/ hold the
//   platform-specific resource loaders (the JVM reads the data from the
//   classpath; JS embeds it). Depends on taihei-tsuji for Language.
// ---------------------------------------------------------------------------
object mihon extends Module {
  // The one copy of the language data, which the JVM reads from the classpath and the build
  // compiles into the Scala.js module.
  def sharedResources = Task.Source(wsRoot / "shared" / "resources")

  // Checked once for both platforms: a file outside the schema fails the build.
  def dataFiles = Task {
    EmbeddedData.check(sharedResources().path).map(PathRef(_))
  }

  def licenceFiles = Task.Sources(wsRoot / "LICENSE", wsRoot / "NOTICE", wsRoot / "LICENSE-UNICODE")

  def metaInf = Task {
    EmbeddedData.metaInf(licenceFiles().map(_.path), Task.dest)
  }

  // The data manifest the shared tests compare the loaded files with, on both platforms.
  def dataManifest = Task {
    EmbeddedData.manifest(sharedResources().path, Task.dest)
  }

  object jvm extends TaiheiModule {
    def artifactName = "taihei-mihon"

    def sources = Task.Sources(
      wsRoot / "shared" / "src",
      wsRoot / "jvm" / "src",
    )
    // The language data, read from the classpath, once the build has checked it, and the
    // licences in META-INF/.
    def resources = Task {
      dataFiles()
      Seq(sharedResources(), metaInf())
    }

    def mvnDeps = Seq(
      mvn"dev.zio::zio-json:${V.zioJson}",
      mvn"dev.taihei::taihei-tsuji:${V.taiheiTsuji}",
    )

    object test extends TaiheiTests {
      def sources = Task.Sources(
        wsRoot / "shared" / "test" / "src",
      )
      def generatedSources = Task(Seq(dataManifest()))
    }
  }

  object js extends TaiheiJSModule {
    def artifactName = "taihei-mihon"

    def sources = Task.Sources(
      wsRoot / "shared" / "src",
      wsRoot / "js" / "src",
    )
    // Only the licences: the data is compiled in.
    def resources    = Task(Seq(metaInf()))

    def mvnDeps = Seq(
      mvn"dev.zio::zio-json::${V.zioJson}",
      mvn"dev.taihei::taihei-tsuji::${V.taiheiTsuji}",
    ) ++ jsDeps

    // Scala.js has no classpath to read the data from, so it is compiled in. It is generated from
    // shared/resources, the one copy the JVM reads too, so the platforms cannot drift apart.
    def generatedSources = Task {
      Seq(EmbeddedData.write(sharedResources().path, Task.dest))
    }

    object test extends TaiheiJSTests {
      def sources = Task.Sources(
        wsRoot / "shared" / "test" / "src",
      )
      def generatedSources = Task(Seq(dataManifest()))
    }
  }

  // A Scala.js program that uses every language, never published: its full-linked size is the
  // budget's measure of what Mihon adds to a browser bundle.
  object budgetFixture extends ScalaJSModule with ScalafmtModule {
    def scalaVersion   = V.scala
    def scalaJSVersion = V.scalaJS
    def moduleDeps     = Seq(js)
    def sources    = Task.Sources(wsRoot / "budget" / "src")
    def mainClass  = Some("dev.taihei.mihon.budget.Main")
  }

  /** Fails when the data, the JVM jar or the full-linked fixture is over its budget. */
  def budget = Task {
    val files     = dataFiles()
    val dataBytes = files.map(f => os.size(f.path)).sum
    val jarBytes  = os.size(jvm.jar().path)
    val linked    = budgetFixture.fullLinkJS().dest.path
    val jsBytes   = os.walk(linked).filter(p => os.isFile(p) && p.ext == "js").map(os.size).sum
    val report = Seq(
      s"data ${dataBytes} bytes (budget ${EmbeddedData.maxDataBytes})",
      s"JVM jar ${jarBytes} bytes (budget ${EmbeddedData.maxJarBytes})",
      s"Scala.js fullLinkJS ${jsBytes} bytes (budget ${EmbeddedData.maxJsBytes})",
    )
    report.foreach(r => println(s"[budget] $r"))
    if (jarBytes > EmbeddedData.maxJarBytes) sys.error(s"the JVM jar is over its budget: ${report(1)}")
    if (jsBytes > EmbeddedData.maxJsBytes) sys.error(s"the full-linked Scala.js is over its budget: ${report(2)}")
    report
  }
}
